<?xml version="1.0"?>
<robot name="two_link_manipulator">
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/><child link="base_link"/>
  </joint>
  <link name="base_link">
    <visual><geometry><cylinder length="0.1" radius="0.2"/></geometry></visual>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/><child link="link1"/>
    <origin xyz="0 0 0.05"/><axis xyz="0 0 1"/>
    <limit effort="10" lower="-3.14" upper="3.14" velocity="1"/>
  </joint>
  <link name="link1">
    <visual><origin xyz="0 0 0.5"/><geometry><cylinder length="1.0" radius="0.05"/></geometry></visual>
  </link>
  <joint name="joint2" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0 0 1.0"/><axis xyz="0 1 0"/>
    <limit effort="10" lower="-1.57" upper="1.57" velocity="1"/>
  </joint>
  <link name="link2">
    <visual><origin xyz="0 0 0.4"/><geometry><cylinder length="0.8" radius="0.04"/></geometry></visual>
  </link>
</robot>

