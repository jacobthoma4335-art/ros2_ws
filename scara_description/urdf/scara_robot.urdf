<?xml version="1.0"?>
<robot name="scara_robot">

  <!-- Materials for coloring -->
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="yellow">
    <color rgba="0.9 0.7 0.0 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <!-- World Frame Link -->
  <link name="world"/>

  <!-- Joint attaching Table to World -->
  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child link="table_base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Table Base Link -->
  <link name="table_base">
    <visual>
      <origin xyz="0 0 0.4" rpy="0 0 0"/>
      <geometry>
        <box size="0.8 0.8 0.8"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- Joint 1: Rotation of the Main Shoulder -->
  <joint name="joint_1" type="revolute">
    <parent link="table_base"/>
    <child link="arm_link_1"/>
    <origin xyz="0 0 0.8" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Arm Link 1 -->
  <link name="arm_link_1">
    <visual>
      <origin xyz="0.15 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.15 0.2"/>
      </geometry>
      <material name="yellow"/>
    </visual>
  </link>

  <!-- Joint 2: Rotation of the Forearm -->
  <joint name="joint_2" type="revolute">
    <parent link="arm_link_1"/>
    <child link="arm_link_2"/>
    <origin xyz="0.3 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.5" upper="2.5" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Arm Link 2 -->
  <link name="arm_link_2">
    <visual>
      <origin xyz="0.15 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.12 0.1"/>
      </geometry>
      <material name="yellow"/>
    </visual>
  </link>

  <!-- Joint 3: Prismatic (Sliding Z-axis tool) -->
  <joint name="joint_3" type="prismatic">
    <parent link="arm_link_2"/>
    <child link="tool_shaft"/>
    <origin xyz="0.3 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.2" upper="0.2" effort="20.0" velocity="0.5"/>
  </joint>

  <!-- Tool Shaft Link -->
  <link name="tool_shaft">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.4"/>
      </geometry>
      <material name="silver"/>
    </visual>
  </link>

  <!-- Joint 4: End Effector Roll / Wrist Rotation -->
  <joint name="joint_4" type="revolute">
    <parent link="tool_shaft"/>
    <child link="end_effector"/>
    <origin xyz="0 0 -0.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="5.0" velocity="2.0"/>
  </joint>

  <!-- End Effector Link -->
  <link name="end_effector">
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

</robot>
